import 'package:get/get.dart';

class LanguageController extends GetxController {
  var selectedLanguageCode = ''.obs;
  var searchQuery = ''.obs;

  final List<LanguageModel> languages = [
    LanguageModel(name: 'United States', code: 'us', flag: '🇺🇸'),
    LanguageModel(name: 'English (UK)', code: 'uk', flag: '🇬🇧'),
    LanguageModel(name: 'Egypt', code: 'eg', flag: '🇪🇬'),
    LanguageModel(name: 'Thailand', code: 'th', flag: '🇹🇭'),
    LanguageModel(name: 'Denmark', code: 'dk', flag: '🇩🇰'),
    LanguageModel(name: 'Germany', code: 'de', flag: '🇩🇪'),
  ];

  List<LanguageModel> get filteredLanguages => searchQuery.value.isEmpty
      ? languages
      : languages
          .where((lang) =>
              lang.name.toLowerCase().contains(searchQuery.value.toLowerCase()))
          .toList();

  void selectLanguage(String code) {
    selectedLanguageCode.value = code;
  }

  void updateSearch(String query) {
    searchQuery.value = query;
  }
}


class LanguageModel {
  final String name;
  final String code;
  final String flag;

  LanguageModel({
    required this.name,
    required this.code,
    required this.flag,
  });
}
